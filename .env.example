# Demo is deterministic sample extraction. Use ollama for real Gemma inference.
FIXFLOW_MODE=demo
# Local default. Production must point inside a persistent disk mount.
FIXFLOW_DB=data/fixflow.db
# Trusted self-hosted Ollama only; never publish its unauthenticated port.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
# Positive, finite inference read timeout, seconds; connection timeout is 5 seconds.
OLLAMA_TIMEOUT=60
# Required for the manager dashboard. Use a long unique password.
MANAGER_PASSWORD=
# Synthetic-data notice only; the manager password remains required.
# Set true only for a site containing synthetic data exclusively.
PUBLIC_DEMO=false
# Optional. Empty DSN disables Sentry. Never put resident data in these values.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Decimal fraction from 0 to 1.
SENTRY_TRACES_SAMPLE_RATE=0.1
